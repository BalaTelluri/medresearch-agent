# Copy to .env and fill in. Never commit the real .env.
# NEVER paste your keys into a chat with anyone - not even me.
# If a key ever leaks, revoke it and make a new one (console.groq.com).

# Groq free tier - https://console.groq.com
GROQ_API_KEY=

# NCBI requires an email with every Entrez request (no key needed)
NCBI_EMAIL=

# Optional - openFDA works without it, the free key only raises the rate limit
OPENFDA_API_KEY=

# LLM backend: groq (default) or ollama for fully local
LLM_BACKEND=groq
LLM_MODEL=openai/gpt-oss-120b
# OLLAMA_BASE_URL=http://localhost:11434
